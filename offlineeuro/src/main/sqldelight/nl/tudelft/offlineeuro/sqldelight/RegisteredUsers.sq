createRegisteredUserTable:
CREATE TABLE IF NOT EXISTS RegisteredUsers (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    publicKey BLOB UNIQUE NOT NULL,
    signedPublicKey BLOB NOT NULL,
    transactionId TEXT NOT NULL,
    isVerified INTEGER NOT NULL
);

addUser:
INSERT INTO RegisteredUsers(name, publicKey, signedPublicKey, transactionId, isVerified)
VALUES (?, ?, ?, ?, ?);

getUserById:
SELECT *
FROM RegisteredUsers
WHERE id = ?;

getUserByPublicKey:
SELECT *
FROM RegisteredUsers
WHERE publicKey = ?;

getUserByName:
SELECT *
FROM RegisteredUsers
WHERE name = ?;

getUserByTransactionId:
SELECT *
FROM RegisteredUsers
WHERE transactionId = ?;

verifyUserByPublicKey:
UPDATE RegisteredUsers
SET isVerified = 1
WHERE publicKey = ?;

getRegisteredUserCount:
SELECT COUNT(*)
FROM RegisteredUsers
WHERE isVerified = 1;

getAllRegisteredUsers:
SELECT *
FROM RegisteredUsers
WHERE isVerified = 1;

clearAllRegisteredUsers:
DELETE FROM RegisteredUsers;
